local function GetServers()
    local servers = {}
    local cursor = ""

    for page = 1, getgenv().Config.ServerPages do
        Status.Text = string.format(
            "Buscando servidores 5/6...\nPágina %d/%d",
            page,
            getgenv().Config.ServerPages
        )

        local url =
            "https://games.roblox.com/v1/games/"
            .. tostring(getgenv().Config.PlaceId)
            .. "/servers/Public?sortOrder=Asc&limit=100"

        if cursor ~= "" then
            url = url .. "&cursor=" .. HttpService:UrlEncode(cursor)
        end

        local success, result = pcall(function()
            return game:HttpGet(url)
        end)

        if not success or not result then
            break
        end

        local decodeSuccess, data = pcall(function()
            return HttpService:JSONDecode(result)
        end)

        if not decodeSuccess or not data then
            break
        end

        for _, server in ipairs(data.data or {}) do
            local players = tonumber(server.playing) or 0
            local maxPlayers = tonumber(server.maxPlayers) or 0

            if players == getgenv().Config.TargetPlayers
                and maxPlayers >= 6
                and server.id
                and server.id ~= game.JobId then

                table.insert(servers, {
                    id = server.id,
                    players = players,
                    maxPlayers = maxPlayers,
                    ping = server.ping
                })
            end
        end

        cursor = data.nextPageCursor or ""
        if cursor == "" then break end
    end

    return servers
end

local function JoinServer()
    if AutoJoinBtn:GetAttribute("Busy") then return end

    AutoJoinBtn:SetAttribute("Busy", true)
    AutoJoinBtn.Text = "BUSCANDO..."
    AutoJoinBtn.BackgroundColor3 = Color3.fromRGB(180, 180, 180)
    Status.Text = "Buscando servidores con 5 jugadores..."

    local success, servers = pcall(GetServers)

    if not success or not servers then
        Status.Text = "Error obteniendo servidores."
        AutoJoinBtn.Text = "AUTO JOIN"
        AutoJoinBtn.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
        AutoJoinBtn:SetAttribute("Busy", false)
        return
    end

    if #servers == 0 then
        Status.Text = "No encontré servidores con 5 jugadores."
        AutoJoinBtn.Text = "AUTO JOIN"
        AutoJoinBtn.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
        AutoJoinBtn:SetAttribute("Busy", false)
        return
    end

    local selectedServer = servers[math.random(1, #servers)]

    Status.Text = string.format(
        "Uniéndote a servidor %d/%d...",
        selectedServer.players,
        selectedServer.maxPlayers
    )

    local teleportSuccess, teleportError = pcall(function()
        TeleportService:TeleportToPlaceInstance(
            getgenv().Config.PlaceId,
            selectedServer.id,
            LocalPlayer
        )
    end)

    if not teleportSuccess then
        warn("Teleport error:", teleportError)
        Status.Text = "No se pudo unir al servidor."
        AutoJoinBtn.Text = "AUTO JOIN"
        AutoJoinBtn.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
        AutoJoinBtn:SetAttribute("Busy", false)
        return
    end

    Status.Text = "Teleport iniciado..."
end

TeleportService.TeleportInitFailed:Connect(function(player, teleportResult, errorMessage)
    if player ~= LocalPlayer then return end

    warn("TeleportInitFailed:", teleportResult, errorMessage)

    if AutoJoinBtn and AutoJoinBtn.Parent then
        AutoJoinBtn.Text = "AUTO JOIN"
        AutoJoinBtn.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
        AutoJoinBtn:SetAttribute("Busy", false)
    end

    if Status and Status.Parent then
        Status.Text = "Falló el teleport."
    end
end)

